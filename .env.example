# Copy to .env and fill in. Never commit .env (it's gitignored).

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *secret* key (sb_secret_...) or the legacy service_role key. Server-only.
SUPABASE_SECRET_KEY=

# Discogs → Settings → Developers → "Create an application"
# (this is an app, not your personal access token — it lets friends sign in too)
# Callback URL: http://localhost:3000/api/auth/discogs/callback (and your Vercel URL later)
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Spotify developer dashboard (optional: adds artist genres/images)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Listening room extras, all optional: each only switches its own facts off.
# Genius → https://genius.com/api-clients → "Generate access token"
GENIUS_ACCESS_TOKEN=
# setlist.fm → https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
# Last.fm → https://www.last.fm/api/account/create (the API key, not the secret)
LASTFM_API_KEY=

# Encrypts the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Protects the daily sync endpoint. Generate with: openssl rand -hex 24
CRON_SECRET=

# Optional: public URL override (only needed behind a tunnel/proxy)
# APP_URL=http://localhost:3000
